FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
# Next.js bakes rewrites and NEXT_PUBLIC_* values into the build, so they are build arguments, not runtime env.
ARG MEMORIA_API_URL=http://api:8000
ARG NEXT_PUBLIC_MEMORIA_WS_ORIGIN=ws://localhost:8000
ENV MEMORIA_API_URL=$MEMORIA_API_URL \
    NEXT_PUBLIC_MEMORIA_WS_ORIGIN=$NEXT_PUBLIC_MEMORIA_WS_ORIGIN \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S -g 10001 web && adduser -S -u 10001 -G web web
COPY --from=build --chown=web:web /app/.next/standalone ./
COPY --from=build --chown=web:web /app/.next/static ./.next/static
COPY --from=build --chown=web:web /app/public ./public
USER web
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["node", "server.js"]
